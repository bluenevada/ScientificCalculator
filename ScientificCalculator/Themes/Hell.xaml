<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fenster und Text -->
    <SolidColorBrush x:Key="FensterHintergrund" Color="#ECE9D8"/>
    <SolidColorBrush x:Key="TextFarbe"          Color="Black"/>
    <SolidColorBrush x:Key="RahmenFarbe"        Color="#ACA899"/>

    <!-- Anzeige -->
    <SolidColorBrush x:Key="AnzeigeHintergrund" Color="White"/>
    <SolidColorBrush x:Key="AnzeigeRand"        Color="#7F9DB9"/>
    <SolidColorBrush x:Key="RechnungFarbe"      Color="Gray"/>

    <!-- Tasten -->
    <LinearGradientBrush x:Key="TasteHintergrund" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F0F0EA" Offset="0.85"/>
        <GradientStop Color="#D6D0C5" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TasteGedrueckt"       Color="#E3E2DA"/>
    <SolidColorBrush x:Key="TasteRand"            Color="#003C74"/>
    <SolidColorBrush x:Key="TasteRandHover"       Color="#F8B330"/>
    <SolidColorBrush x:Key="TasteRandDeaktiviert" Color="#C9C7BA"/>

    <!-- Schriftfarben der Tasten -->
    <SolidColorBrush x:Key="FarbeZiffer"      Color="Blue"/>
    <SolidColorBrush x:Key="FarbeOperator"    Color="Red"/>
    <SolidColorBrush x:Key="FarbeFunktion"    Color="Purple"/>
    <SolidColorBrush x:Key="FarbeDeaktiviert" Color="#ACA899"/>
</ResourceDictionary>
    